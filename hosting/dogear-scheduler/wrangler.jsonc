// dogear-scheduler: DOGEAR's read-only watchdog (DOGEAR-WATCHDOG-PLAN rev 4 and
// DOGEAR-WATCHDOG-ALERTS-PLAN rev 2, Codex CLEAR). Detection is GitHub GET
// only (read-only token) and the public host GET only; alerts are issues opened by a
// GitHub App in the private repository dogear-alerts, assigned to the owner.
// Enabled on the production target, the unattended Friday stage and Monday promote
// (PUBLISHING 4b; a reviewed PR); WATCH_ENABLED "false" (another reviewed PR) makes it
// inert again.
// Secrets, set by the owner with `wrangler secret put`, never committed:
//   GITHUB_READ_TOKEN          fine-grained, archievalmariano/dogear only: Actions, Contents
//                              and Metadata READ; check it first with tools/watchdog_token_check.sh
//   ALERT_APP_ID               the alert App's numeric ID
//   ALERT_APP_INSTALLATION_ID  its installation on dogear-alerts (the only one)
//   ALERT_APP_PRIVATE_KEY      its private key, PKCS#8 PEM; test the channel once with
//                              tools/watchdog_alert_test.mjs before enabling
// The crons MUST equal DECLARED_CRONS in src/index.js (a test enforces it).
{
  "name": "dogear-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-10-16",
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": {
    "crons": ["0 6 * * 5", "0 12 * * 5", "0 1 * * 1", "0 4 * * 1", "0 5 * * *"]
  },
  "vars": {
    "GITHUB_OWNER": "archievalmariano",
    "GITHUB_REPO": "dogear",
    "WATCH_TARGET": "production",
    "WATCH_ENABLED": "true",
    "ALERT_REPO": "dogear-alerts"
  }
}
